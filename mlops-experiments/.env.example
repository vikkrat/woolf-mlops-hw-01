# Локальні адреси працюють після kubectl port-forward (див. README.md).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
PUSHGATEWAY_URL=http://127.0.0.1:9091

# Ці облікові дані належать лише одноразовому навчальному середовищу.
# У production використовуйте Kubernetes Secret + External Secrets/Secrets Manager.
AWS_ACCESS_KEY_ID=mlflow
AWS_SECRET_ACCESS_KEY=mlflow-demo-password
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000

